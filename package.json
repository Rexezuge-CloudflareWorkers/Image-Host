{
  "name": "@image-host/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm -r build",
    "checks:fast": "pnpm run typecheck && pnpm run lint",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.2.2"
}