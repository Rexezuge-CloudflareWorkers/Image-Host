{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-host",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": [],
  "preview_urls": false,
  "workers_dev": true,
  "minify": true,
  "observability": { "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true } },
  "assets": { "directory": "./apps/web/dist/" },
  "d1_databases": [
    {
      "binding": "ImageHostDB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "image-host-db"
    }
  ],
  "vars": {
    "POLICY_AUD": "you-cloudflare-zero-trust-application-aud",
    "TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
    "TG_CHAT_ID": "-1000000000000",
    "MAX_UPLOAD_BYTES": "20971520",
    "LOG_LEVEL": "info",
    "ENVIRONMENT": "production"
  }
}