{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-host",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": [],
  "preview_urls": false,
  "workers_dev": true,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "assets": {
    "directory": "./apps/web/dist/",
  },
  "d1_databases": [
    {
      "binding": "ImageHostDB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "image-host-db",
    },
  ],
  "triggers": {
    // The daily `image_views` retention prune, handled by `handleScheduled`.
    // Only this Worker target may carry it: the Pages SPA has no cron triggers.
    // 03:17 UTC — daily, off the hour where trigger traffic is thinnest.
    "crons": ["17 3 * * *"],
  },
  "secrets_store_secrets": [
    {
      "binding": "IMAGE_HOST_SECRETS",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "image-host-telegram-bot-token",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "false",
    "DEV_AUTH_EMAIL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_UPLOAD_BYTES": "20971520",
    "VIEW_LOG_RETENTION_DAYS": "30",
    "TELEGRAM_CHAT_ID": "",
  },
}
